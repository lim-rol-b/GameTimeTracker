<Window x:Class="GameActivityTracker.Windows.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:GameActivityTracker.Windows.UI" Title="游戏时长记录器" Width="1240" Height="860" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="0,24,0,24">
  <Grid DockPanel.Dock="Top" Margin="30,0,30,26"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="◉  游戏时长记录" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding PageTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PageTitle}" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Width="42" Height="42" Padding="0" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnToggleSettings">
   <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="ToolTip" Value="设置"/><Setter Property="AutomationProperties.Name" Value="设置"/>
    <Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="1"><Setter Property="ToolTip" Value="返回主页面"/><Setter Property="AutomationProperties.Name" Value="返回主页面"/></DataTrigger></Style.Triggers>
   </Style></Button.Style>
   <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource TextBrush}">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE713;"/><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="1"><Setter Property="Text" Value="&#xE72B;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </Button></Grid>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="30,18,30,0" TextWrapping="Wrap"/>
  <TabControl SelectedIndex="{Binding SelectedTab}" Padding="0">
   <TabControl.Template><ControlTemplate TargetType="TabControl">
    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource TextBrush}"/>
   </ControlTemplate></TabControl.Template>
   <TabItem Header="概览"><ScrollViewer x:Name="OverviewScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel Margin="30,22,16,0">

    <TextBlock FontSize="23" FontWeight="SemiBold" Margin="0,4,12,18"><Run Text="{Binding Year}"/><Run Text=" 年游戏记录"/></TextBlock>
    <ItemsControl ItemsSource="{Binding Metrics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14,18"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" FontSize="10"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Grid Margin="0,0,12,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
     <Border x:Name="AnnualHeatmapCard" Style="{StaticResource HeatmapCard}" Margin="0"><StackPanel><TextBlock Foreground="{DynamicResource TextBrush}" Text="游戏活跃记录" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/><ui:HeatmapView DataContext="{Binding Heatmap}"/></StackPanel></Border>
     <ListBox Grid.Column="2" ItemsSource="{Binding Years}" SelectedItem="{Binding Year, Mode=TwoWay}" Height="{Binding ActualHeight, ElementName=AnnualHeatmapCard}" VerticalAlignment="Top"
      Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ItemContainerStyle="{StaticResource YearItem}" PreviewMouseWheel="OnYearWheel"/>
    </Grid>
   </StackPanel></ScrollViewer></TabItem>

   <TabItem Header="设置">
    <DockPanel Margin="30,12,30,0">
     <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="保存设置" Background="{DynamicResource AccentSoftBrush}" Command="{Binding SaveSettings}"/></StackPanel>
     <TabControl SelectedIndex="{Binding SettingsCategory}" TabStripPlacement="Left">
      <TabControl.Resources>
       <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
         <Border x:Name="Category" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Category" Property="Background" Value="{DynamicResource ControlBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Category" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style>
      </TabControl.Resources>
      <TabControl.Template><ControlTemplate TargetType="TabControl">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/></ScrollViewer>
        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="2" ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource TextBrush}"/>
       </Grid>
      </ControlTemplate></TabControl.Template>
      <TabItem Header="游戏管理"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">    <StackPanel Margin="0,0,0,28"><StackPanel><TextBlock Foreground="{DynamicResource TextBrush}" Text="游戏管理" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="添加游戏本体的可执行文件；启动器、渲染进程可作为额外规则。多条规则满足任意一条即可，单条规则内的条件需同时满足。" Foreground="{DynamicResource TextBrush}" Margin="0,10,0,18" TextWrapping="Wrap"/><WrapPanel Margin="0,0,0,18"><Button Content="＋ 添加游戏" Command="{Binding AddGame}" Background="{DynamicResource AccentSoftBrush}"/><Button Content="导入 Steam 游戏库…" Command="{Binding ImportSteamLibrary}" Background="{DynamicResource AccentSoftBrush}"/><Button Content="手动选库…" Command="{Binding ImportSteamLibrary}" CommandParameter="manual"/><Button Content="查看统计" Command="{Binding OpenGame}"/><Button Content="编辑游戏 / 规则" Command="{Binding EditGame}"/><Button Content="删除游戏" Command="{Binding DeleteGame}"/></WrapPanel></StackPanel><DataGrid MaxHeight="420" MinHeight="160" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" IsReadOnly="True" MouseDoubleClick="OnGameDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="游戏" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="可执行文件路径" Binding="{Binding Executable}" Width="*"/><DataGridTextColumn Header="活跃时长" Binding="{Binding Active}" Width="110"/><DataGridTextColumn Header="运行时长" Binding="{Binding Running}" Width="110"/><DataGridTextColumn Header="游玩记录" Binding="{Binding Sessions}" Width="90"/></DataGrid.Columns></DataGrid></StackPanel>
</StackPanel></ScrollViewer></TabItem>
      <TabItem Header="外观"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">    <TextBlock Foreground="{DynamicResource TextBrush}" Text="外观" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ThemeMode, Mode=TwoWay}" Margin="0,0,0,8"/>
    <TextBlock Text="主题立即生效并保存；跟随系统会自动响应 Windows 应用颜色模式。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,24"/>
</StackPanel></ScrollViewer></TabItem>
      <TabItem Header="记录设置"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">    <TextBlock Foreground="{DynamicResource TextBrush}" Text="记录设置" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <TextBlock Foreground="{DynamicResource TextBrush}" Text="空闲阈值 · 秒（1–3600，默认 60）"/><TextBox Text="{Binding IdleThresholdText, UpdateSourceTrigger=PropertyChanged}" Width="240" HorizontalAlignment="Left"/>
    <TextBlock Foreground="{DynamicResource TextBrush}" Text="进程扫描间隔 · 秒（1–60，默认 2）"/><TextBox Text="{Binding ScanIntervalText, UpdateSourceTrigger=PropertyChanged}" Width="240" HorizontalAlignment="Left"/>
</StackPanel></ScrollViewer></TabItem>
      <TabItem Header="手柄"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">    <TextBlock Foreground="{DynamicResource TextBrush}" Text="手柄" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/><CheckBox Content="启用 Xbox / XInput 手柄检测" IsChecked="{Binding Settings.EnableControllerDetection}"/>
    <TextBlock Foreground="{DynamicResource TextBrush}" Text="摇杆死区 · 0.05–0.95（默认 0.20）"/><TextBox Text="{Binding DeadZoneText, UpdateSourceTrigger=PropertyChanged}" Width="240" HorizontalAlignment="Left"/>
</StackPanel></ScrollViewer></TabItem>
      <TabItem Header="系统"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0">    <TextBlock Foreground="{DynamicResource TextBrush}" Text="系统" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/><CheckBox Content="登录 Windows 时启动" IsChecked="{Binding Settings.StartWithWindows}"/>
</StackPanel></ScrollViewer></TabItem>
      <TabItem Header="数据与隐私"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,14,0"><TextBlock Foreground="{DynamicResource TextBrush}" Text="数据与隐私" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>    <TextBlock Text="隐私：仅检测是否有输入，不记录键盘文本、鼠标轨迹或其他应用内容。手柄原始状态只在内存中短暂比较，不写入数据库。" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,16,0,14"/>
<TextBlock Foreground="{DynamicResource TextBrush}" Text="{Binding DataDirectory}" TextWrapping="Wrap" Margin="0,0,0,18"/><Button Content="打开日志目录" Command="{Binding OpenLogs}" HorizontalAlignment="Left"/></StackPanel></ScrollViewer></TabItem>
     </TabControl>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
