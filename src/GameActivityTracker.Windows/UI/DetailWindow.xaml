<Window x:Class="GameActivityTracker.Windows.UI.DetailWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:GameActivityTracker.Windows.UI" Title="{Binding Title}" Width="1140" Height="780" MinWidth="780" MinHeight="500" WindowStartupLocation="CenterOwner">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28">
  <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextBrush}" FontSize="12"/><TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,22"/>
  <Border Style="{StaticResource Card}"><TextBlock Text="{Binding Summary}" FontSize="18" TextWrapping="Wrap"/></Border>
  <Border Style="{StaticResource HeatmapCard}" Visibility="{Binding HeatmapVisibility}"><ui:HeatmapView DataContext="{Binding Heatmap}"/></Border>
  <Grid Visibility="{Binding HourlyHeatmapVisibility}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="340"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource HeatmapCard}"><ui:HourlyHeatmapView DataContext="{Binding HourlyHeatmap}"/></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
    <StackPanel>
     <TextBlock Text="各游戏时长" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <TextBlock Text="当天暂无游戏记录" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding EmptyGamesVisibility}"/>
     <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Games}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14"><StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="活跃时长" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Active}" FontSize="18" Margin="0,4,0,0"/></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock Text="运行时长" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding Running}" FontSize="18" Margin="0,4,0,0"/></StackPanel>
        </Grid>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
    </StackPanel>
   </Border>
  </Grid>
  <StackPanel Visibility="{Binding SessionsVisibility}">
  <TextBlock Text="Sessions" FontSize="20" Margin="0,10,0,12"/><TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
  <DataGrid ItemsSource="{Binding Sessions}" IsReadOnly="True" MaxHeight="420"><DataGrid.Columns><DataGridTextColumn Header="Game" Binding="{Binding Game}" Width="150"/><DataGridTextColumn Header="Started" Binding="{Binding Start}" Width="170"/><DataGridTextColumn Header="Ended" Binding="{Binding End}" Width="140"/><DataGridTextColumn Header="Active" Binding="{Binding Active}" Width="90"/><DataGridTextColumn Header="Running" Binding="{Binding Running}" Width="90"/><DataGridTextColumn Header="Idle" Binding="{Binding Idle}" Width="90"/><DataGridTextColumn Header="Background" Binding="{Binding Background}" Width="105"/><DataGridTextColumn Header="Source / end reason" Binding="{Binding Source}" Width="300"/></DataGrid.Columns></DataGrid>
  </StackPanel>
 </StackPanel></ScrollViewer>
</Window>
