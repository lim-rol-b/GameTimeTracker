<Window x:Class="GameActivityTracker.Windows.UI.SteamLibraryImportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="导入 SteamLibrary" Width="1180" Height="700" MinWidth="940" MinHeight="520" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="26">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="从 SteamLibrary 导入游戏" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <TextBlock Text="{Binding LibraryPath}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Summary}" Margin="0,12,0,8"/>
   <TextBlock Text="勾选要添加的游戏并确认主 exe。优先预选与游戏文件夹同名的 exe（忽略空格、符号及大小写）；候选不明确时请自行选择。卸载器、引擎工具及崩溃报告程序已过滤，可用“选择…”手动指定。" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
   <TextBlock Text="导入后自动建立完整路径识别规则，开始记录此后的活动；不会导入或推算 Steam 历史时长。" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
    <Button Content="选中已配置 exe 的游戏" Command="{Binding SelectReady}"/>
    <Button Content="取消全选" Command="{Binding ClearSelection}"/>
   </StackPanel>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
   <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Visibility="{Binding WarningsVisibility}">
    <TextBlock Text="{Binding Warnings}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
   </ScrollViewer>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="取消" IsCancel="True"/>
    <Button Content="导入选中游戏" Background="{DynamicResource AccentSoftBrush}" Click="Import" IsDefault="True"/>
   </StackPanel>
  </StackPanel>
  <DataGrid ItemsSource="{Binding Games}" CanUserSortColumns="True">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="导入" Width="60">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanImport}" HorizontalAlignment="Center"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="游戏" Binding="{Binding Game.Name}" Width="190" IsReadOnly="True"/>
    <DataGridTextColumn Header="AppID" Binding="{Binding Game.AppId}" Width="90" IsReadOnly="True"/>
    <DataGridTemplateColumn Header="游戏主 exe" Width="*" MinWidth="200">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <ComboBox ItemsSource="{Binding Executables}" SelectedItem="{Binding SelectedExecutable, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanImport}" ToolTip="{Binding SelectedExecutable.Path}" Margin="4,3">
       <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTemplateColumn Width="90">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <Button Content="选择…" Padding="8,3" IsEnabled="{Binding CanImport}" Command="{Binding DataContext.BrowseExecutable, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="190" IsReadOnly="True"/>
    <DataGridTextColumn Header="安装目录" Binding="{Binding Game.InstallDirectory}" Width="220" IsReadOnly="True"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
