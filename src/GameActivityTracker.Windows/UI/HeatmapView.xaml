<UserControl x:Class="GameActivityTracker.Windows.UI.HeatmapView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Background="{DynamicResource HeatmapBackground}">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,30,0,0">
    <TextBlock Foreground="{DynamicResource TextBrush}" Text="Mon" Height="21" Padding="0,1.5,0,0" FontSize="11"/>
    <TextBlock Foreground="{DynamicResource TextBrush}" Text="Tue" Height="21" Padding="0,1.5,0,0" FontSize="11"/>
    <TextBlock Foreground="{DynamicResource TextBrush}" Text="Wed" Height="21" Padding="0,1.5,0,0" FontSize="11"/>
    <TextBlock Foreground="{DynamicResource TextBrush}" Text="Thu" Height="21" Padding="0,1.5,0,0" FontSize="11"/>
    <TextBlock Foreground="{DynamicResource TextBrush}" Text="Fri" Height="21" Padding="0,1.5,0,0" FontSize="11"/>
    <TextBlock Foreground="{DynamicResource TextBrush}" Text="Sat" Height="21" Padding="0,1.5,0,0" FontSize="11"/>
    <TextBlock Foreground="{DynamicResource TextBrush}" Text="Sun" Height="21" Padding="0,1.5,0,0" FontSize="11"/>
   </StackPanel>
   <ScrollViewer x:Name="CalendarScroller" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"
    PreviewMouseLeftButtonDown="OnPointerDown" PreviewMouseMove="OnPointerMove" PreviewMouseLeftButtonUp="OnPointerUp" LostMouseCapture="OnCaptureLost" PreviewMouseWheel="OnWheel">
    <StackPanel Width="{Binding CalendarWidth}">
     <ItemsControl ItemsSource="{Binding Months}" Height="30" Width="{Binding CalendarWidth}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Offset}"/></Style></ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="{DynamicResource TextBrush}" Text="{Binding Name}" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <ItemsControl ItemsSource="{Binding Days}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Vertical" Height="147"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Style="{StaticResource HeatmapTile}" Background="{Binding Color}" Opacity="{Binding Opacity}" IsEnabled="{Binding InYear}"
        AutomationProperties.Name="{Binding Label}" Command="{Binding DataContext.SelectDay, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
        <Button.ToolTip><ToolTip Style="{StaticResource HeatmapHoverTip}"><TextBlock Text="{Binding Tooltip}" Foreground="White"/></ToolTip></Button.ToolTip>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0">
   <TextBlock Foreground="{DynamicResource TextBrush}" Text="Less" FontSize="11" Margin="0,0,8,0"/>
   <Border Background="{DynamicResource Heat0}" Width="12" Height="12" Margin="2"/><Border Background="{DynamicResource Heat1}" Width="12" Height="12" Margin="2"/><Border Background="{DynamicResource Heat2}" Width="12" Height="12" Margin="2"/><Border Background="{DynamicResource Heat3}" Width="12" Height="12" Margin="2"/><Border Background="{DynamicResource Heat4}" Width="12" Height="12" Margin="2"/><Border Background="{DynamicResource Heat5}" Width="12" Height="12" Margin="2"/>
   <TextBlock Foreground="{DynamicResource TextBrush}" Text="More · 0 / ≤30m / ≤1h / ≤2h / ≤4h / 4h+" FontSize="11" Margin="8,0,0,0"/>
  </WrapPanel>
 </StackPanel>
</UserControl>
